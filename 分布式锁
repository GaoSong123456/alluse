悲观锁
@Lock(LockModeType.PESSIMISTIC_WRITE) 注解是用于在 JPA 查询中指定悲观锁的。我们可以使用这个注解来确保在读取数据时加锁，防止其他事务修改数据。
package com.example.device.repository;

import com.example.device.entity.DeviceInfo;
import org.springframework.data.jpa.repository.JpaRepository;
import org.springframework.data.jpa.repository.Lock;
import org.springframework.stereotype.Repository;
import javax.persistence.LockModeType;

@Repository
public interface DeviceInfoRepository extends JpaRepository<DeviceInfo, Long> {
    @Lock(LockModeType.PESSIMISTIC_WRITE)
    Optional<DeviceInfo> findById(Long id);
}



package com.example.device.service;

import com.example.device.entity.AllocationDetail;
import com.example.device.entity.AllocationMain;
import com.example.device.entity.DeviceInfo;
import com.example.device.repository.AllocationDetailRepository;
import com.example.device.repository.AllocationMainRepository;
import com.example.device.repository.DeviceInfoRepository;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.Set;

@Service
public class AllocationService {
    @Autowired
    private AllocationMainRepository allocationMainRepository;

    @Autowired
    private AllocationDetailRepository allocationDetailRepository;

    @Autowired
    private DeviceInfoRepository deviceInfoRepository;

    @Transactional
    public AllocationMain allocateDevices(String allocatedBy, Set<AllocationDetail> allocationDetails) {
        AllocationMain allocationMain = new AllocationMain();
        allocationMain.setAllocatedBy(allocatedBy);

        for (AllocationDetail detail : allocationDetails) {
            DeviceInfo deviceInfo = deviceInfoRepository.findById(detail.getDeviceInfo().getId())
                    .orElseThrow(() -> new RuntimeException("Device not found"));

            if (deviceInfo.getStatus().equals("available")) {
                deviceInfo.setStatus("allocated");
                deviceInfo.setAllocation(allocationMain);
                deviceInfoRepository.save(deviceInfo);
                allocationMain.addDetail(detail);
            } else {
                throw new RuntimeException("Device " + deviceInfo.getId() + " is not available");
            }
        }

        allocationMain = allocationMainRepository.save(allocationMain);
        return allocationMain;
    }

    @Transactional
    public void approveAllocation(Long allocationId) {
        AllocationMain allocationMain = allocationMainRepository.findById(allocationId)
                .orElseThrow(() -> new RuntimeException("Allocation not found"));

        if (allocationMain.getStatus().equals("pending")) {
            allocationMain.setStatus("approved");
            allocationMainRepository.save(allocationMain);
        } else {
            throw new RuntimeException("Allocation is not pending");
        }
    }
}


事务隔离级别
@Transactional(isolation = Isolation.SERIALIZABLE) 注解来设置事务隔离级别为 Serializable，这是最严格的隔离级别，可以防止所有并发问题，但可能会降低性能


redis分布式锁
1. 配置文件
在application.yml中添加Redis的配置信息：

spring:
  redis:
    mode: single  # 或者 cluster
    nodes: localhost:6379  # 单节点或集群节点列表，例如 "localhost:6379,localhost:6380"
    password:  # 如果有密码
    database: 0  # 默认数据库
2. 创建Redisson配置类
创建一个配置类来初始化Redisson客户端，并从配置文件中读取Redis的连接信息：

import org.redisson.Redisson;
import org.redisson.api.RedissonClient;
import org.redisson.config.Config;
import org.redisson.config.SingleServerConfig;
import org.redisson.config.ClusterServersConfig;
import org.springframework.beans.factory.annotation.Value;
import org.springframework.context.annotation.Bean;
import org.springframework.context.annotation.Configuration;

@Configuration
public class RedissonConfig {

    @Value("${spring.redis.mode}")
    private String mode;

    @Value("${spring.redis.nodes}")
    private String nodes;

    @Value("${spring.redis.password}")
    private String password;

    @Value("${spring.redis.database}")
    private int database;

    @Bean
    public RedissonClient redissonClient() {
        Config config = new Config();
        if ("single".equalsIgnoreCase(mode)) {
            SingleServerConfig singleServerConfig = config.useSingleServer()
                    .setAddress("redis://" + nodes)
                    .setPassword(password)
                    .setDatabase(database);
            // 可以添加更多配置项
        } else if ("cluster".equalsIgnoreCase(mode)) {
            ClusterServersConfig clusterServersConfig = config.useClusterServers()
                    .addNodeAddress("redis://" + nodes.split(","))
                    .setPassword(password)
                    .setDatabase(database);
            // 可以添加更多配置项
        } else {
            throw new IllegalArgumentException("Unsupported Redis mode: " + mode);
        }
        return Redisson.create(config);
    }
}
3. 使用分布式锁
在需要使用分布式锁的业务逻辑中，注入RedissonClient并使用它来获取锁：

import org.redisson.api.RLock;
import org.redisson.api.RedissonClient;
import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.stereotype.Service;
import org.springframework.transaction.annotation.Transactional;

import java.util.concurrent.TimeUnit;

@Service
public class DistributedLockService {

    @Autowired
    private RedissonClient redissonClient;

    @Transactional
    public void performTask(Long id) {
        // 使用记录的 id 作为锁的键
        String lockKey = "lock:" + id;
        // 获取锁
        RLock lock = redissonClient.getLock(lockKey);

        try {
            // 尝试获取锁，最多等待10秒，锁的有效期为30秒
            boolean isLocked = lock.tryLock(10, 30, TimeUnit.SECONDS);
            if (!isLocked) {
                throw new RuntimeException("无法获取锁，任务失败...");
            }

            // 执行业务逻辑
            System.out.println("执行业务逻辑...");
            // 模拟业务逻辑中的异常
            // int i = 1 / 0;

        } catch (InterruptedException e) {
            Thread.currentThread().interrupt();
            throw new RuntimeException("线程被中断: " + e.getMessage(), e);
        } finally {
            // 释放锁
            if (lock.isHeldByCurrentThread()) {
                lock.unlock();
            }
        }
    }
}

//为避免在锁的有效时间内业务代码未执行完导致锁时间到期提前释放，可以使用 Redisson 的看门狗机制（Watchdog）
Redisson 提供了 自动续租锁 的机制（Watchdog），可以避免手动设置租约时间。
优点：锁会在业务执行期间自动续租，直到业务逻辑完成或显式释放。
@Service
public class DistributedLockService {

    @Autowired
    private RedissonClient redissonClient;

    public void performTask(Long id) {
        String lockKey = "lock:" + id;
        RLock lock = redissonClient.getLock(lockKey);

        try {
            // 不设置租约时间，启用 Watchdog 自动续租
            lock.lock();  // 自动开启看门狗
            System.out.println("成功获取锁，开始执行业务逻辑...");

            // 模拟长时间执行
            Thread.sleep(40_000);  // 40 秒

            // 正常执行业务逻辑
        } finally {
            if (lock.isLocked() && lock.isHeldByCurrentThread()) {
                lock.unlock();  // 显式释放锁
            }
        }
    }
}
🔍 原理说明
lock.lock()：Redisson 会为锁开启一个 看门狗线程，默认每 30 秒自动续租一次。
优点：无需担心租约时间，锁会自动续租，直到业务完成。
缺点：如果业务逻辑中未显式调用 unlock()，可能会导致锁一直被持有（需依赖超时机制或系统关闭时自动释放）。

4. 调用服务
在控制器或其他地方调用DistributedLockService中的方法：

import org.springframework.beans.factory.annotation.Autowired;
import org.springframework.web.bind.annotation.GetMapping;
import org.springframework.web.bind.annotation.RestController;

@RestController
public class LockController {

    @Autowired
    private DistributedLockService distributedLockService;

    @GetMapping("/execute-task")
    public String executeTask(@RequestParam Long id) {
        distributedLockService.performTask(id);
        return "任务执行完毕";
    }
}
