三、消息队列与交换机声明
1. 配置队列和交换机
@Configuration
public class RabbitConfig {

    // 正常队列
    @Bean
    public DirectExchange normalExchange() {
        return new DirectExchange("normal_exchange");
    }

    @Bean
    public Queue normalQueue() {
        return QueueBuilder.durable("normal_queue")
                .withArgument("x-dead-letter-exchange", "dead_letter_exchange")  // 死信交换机
                .withArgument("x-message-ttl", 10000)  // 10秒后进入死信队列
                .build();
    }

    @Bean
    public Binding bindingNormal(Queue normalQueue, DirectExchange normalExchange) {
        return BindingBuilder.bind(normalQueue).to(normalExchange).with("normal_key").noargs();
    }

    // 死信队列
    @Bean
    public DirectExchange deadLetterExchange() {
        return new DirectExchange("dead_letter_exchange");
    }

    @Bean
    public Queue deadLetterQueue() {
        return QueueBuilder.durable("dead_letter_queue").build();
    }

    @Bean
    public Binding bindingDeadLetter(Queue deadLetterQueue, DirectExchange deadLetterExchange) {
        return BindingBuilder.bind(deadLetterQueue).to(deadLetterExchange).with("dead_key").noargs();
    }
}
四、消息生产者（幂等性 + 可靠性）
1. 生成唯一消息ID
